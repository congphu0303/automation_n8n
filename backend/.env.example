# ═══════════════════════════════════════════════════════════════════
# APPROVEHUB — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local for local development
#   cp backend/.env.example backend/.env.local
#
# For production, use .env (tracked by git, contains non-sensitive defaults)
#
# ─── MONGODB ATLAS ────────────────────────────────────────────────
# Shared MongoDB Atlas cluster. All environments use the same database.
# Get your connection string from: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/approval_system

# ─── JWT SECRET KEY ───────────────────────────────────────────────
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-64-char-hex-string>

# ─── APPLICATION ─────────────────────────────────────────────────
PORT=3001
# NODE_ENV: development (local) or production (docker/VPS)

# ─── URLs ────────────────────────────────────────────────────────
# FRONTEND_URL: used to generate approval links in emails
#   Local:     http://localhost:3000
#   Production: https://approvehub.internalautomation.io.vn
FRONTEND_URL=http://localhost:3000

# N8N_URL: N8N instance URL
#   Local (Docker): http://localhost:5678
#   Production:     http://n8n:5678 (Docker internal) or https://n8n.yourdomain.com
N8N_URL=http://localhost:5678

# ─── CORS ────────────────────────────────────────────────────────
# Allowed origins for CORS. Separate multiple origins with commas.
#   Local:         http://localhost:3000
#   Production:    https://approvehub.internalautomation.io.vn
ALLOWED_ORIGIN_1=http://localhost:3000

# ─── N8N SECRET KEY ─────────────────────────────────────────────
# Shared secret between Backend and N8N for internal API authentication.
# Must match N8N_SECRET_KEY in docker-compose.yml or docker-compose.local.yml
N8N_SECRET_KEY=approvehubs3cr3t
