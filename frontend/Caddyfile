# Caddyfile - Serve React SPA + Proxy API to backend

:3000 {
    root * /usr/share/caddy
    file_server

    # SPA routing - all routes EXCEPT api and assets go to index.html
    @spa {
        not {
            path /api/*
            path /assets/*
        }
    }
    rewrite @spa /index.html

    # Proxy API requests to backend
    @api {
        path /api/*
    }
    reverse_proxy @api approval_backend:3001

    encode gzip
}
